---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/sections/CTABanner.astro';
---

<BaseLayout
  title="Daily Catch Reports | Fish The Wahoo"
  description="Daily fish reports and trip updates from Fish The Wahoo fishing charters out of Charleston, SC."
>
  <section class="pt-32 pb-8 bg-nautical-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="section-label">Trip Reports</span>
      <h1 class="text-5xl md:text-6xl text-white uppercase mb-6">Daily Catch</h1>
      <div class="w-24 h-1 bg-accent-orange mb-8"></div>
      <p class="text-slate-400 text-lg leading-relaxed">
        Trip reports, daily catch updates, and fishing conditions from the Fish The Wahoo fleet.
        Follow along to see what's biting off Charleston.
      </p>
    </div>
  </section>

  <section class="py-16 bg-nautical-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-nautical-blue rounded-xl p-12 text-center border border-white/10">
        <p class="text-slate-400 text-lg mb-4">Trip reports are being migrated to our new site.</p>
        <p class="text-slate-500 text-sm">
          Follow us on
          <a href="https://instagram.com/fishthewahoo" target="_blank" rel="noopener noreferrer" class="text-accent-orange hover:underline">Instagram @fishthewahoo</a>
          for the latest catches and conditions.
        </p>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
