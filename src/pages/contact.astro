---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../react-islands/ContactForm';
import { Phone, Mail, MapPin, Clock } from 'lucide-react';
---

<BaseLayout
  title="Contact Fish The Wahoo | Charleston Fishing Charters"
  description="Contact Fish The Wahoo deep sea fishing charters in Charleston, SC. Call (843) 312-2981 or send us a message."
>
  <section class="pt-32 pb-8 bg-nautical-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="section-label">Get In Touch</span>
      <h1 class="text-5xl text-white uppercase mb-4">Contact Us</h1>
      <div class="w-24 h-1 bg-accent-orange"></div>
    </div>
  </section>

  <section class="py-16 bg-nautical-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <div class="space-y-8 mb-12">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent-orange/10 border border-accent-orange/20 rounded-lg flex items-center justify-center shrink-0">
                <Phone className="w-5 h-5 text-accent-orange" />
              </div>
              <div>
                <p class="text-white/40 text-xs font-bold uppercase tracking-widest mb-1">Phone</p>
                <a href="tel:8433122981" class="text-slate-200 hover:text-accent-orange transition-colors">(843) 312-2981</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent-orange/10 border border-accent-orange/20 rounded-lg flex items-center justify-center shrink-0">
                <Mail className="w-5 h-5 text-accent-orange" />
              </div>
              <div>
                <p class="text-white/40 text-xs font-bold uppercase tracking-widest mb-1">Email</p>
                <a href="mailto:chuck141w@yahoo.com" class="text-slate-200 hover:text-accent-orange transition-colors">chuck141w@yahoo.com</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent-orange/10 border border-accent-orange/20 rounded-lg flex items-center justify-center shrink-0">
                <MapPin className="w-5 h-5 text-accent-orange" />
              </div>
              <div>
                <p class="text-white/40 text-xs font-bold uppercase tracking-widest mb-1">Location</p>
                <p class="text-slate-200 whitespace-pre-line">Shem Creek Marina<br />Mount Pleasant, SC 29464</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent-orange/10 border border-accent-orange/20 rounded-lg flex items-center justify-center shrink-0">
                <Clock className="w-5 h-5 text-accent-orange" />
              </div>
              <div>
                <p class="text-white/40 text-xs font-bold uppercase tracking-widest mb-1">Hours</p>
                <p class="text-slate-200 whitespace-pre-line">Daily 6am — 8pm<br />After hours for emergencies</p>
              </div>
            </div>
          </div>

          <div class="aspect-video rounded-xl overflow-hidden bg-nautical-blue border border-white/10">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3352.123456789!2d-79.877!3d32.784!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzLCsDQ3JzAyLjQiTiA3OcKwNTInMzMuMiJX!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus"
              class="w-full h-full"
              allowfullscreen
              loading="lazy"
              title="Fish The Wahoo location"
            ></iframe>
          </div>
        </div>

        <div class="metallic-card rounded-xl p-8">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
