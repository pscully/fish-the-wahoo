---
import { Ruler, Users, ChevronRight } from 'lucide-react';
import { formatCents } from '../../lib/format';
import { boats } from '../../content/boats';

const mobileOrder = ['order-3 md:order-none', 'order-2 md:order-none', 'order-1 md:order-none'];
---

<section id="packages" class="py-24 bg-nautical-dark relative overflow-hidden">
  <div class="absolute inset-0 opacity-5 pointer-events-none">
    <div class="absolute top-20 left-10 w-64 h-64 border border-white rounded-full"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 border border-white rounded-full"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <span class="section-label">Start With The Boat</span>
      <h2 class="text-4xl md:text-5xl text-white mb-4 uppercase">Deep Sea Fishing Pricing</h2>
      <div class="section-divider"></div>
      <p class="text-slate-400 max-w-2xl mx-auto mb-4">
        Fifteen different boats at our disposal in three different size classes. With
        Charleston's finest captains and crew, all fifteen boats are capable of delivering
        a fishing trip of a lifetime.
      </p>
      <p class="text-slate-400 max-w-2xl mx-auto">Which boat class and package is best for you?</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {boats.map((boat, index) => (
        <div
          class:list={[
            'metallic-card rounded-xl flex flex-col h-full group relative card-rise',
            mobileOrder[index] ?? '',
            boat.isMostPopular ? 'ring-2 ring-accent-gold shadow-2xl shadow-accent-gold/20' : '',
          ]}
        >
          {boat.isMostPopular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-20 bg-accent-gold text-nautical-dark text-xs font-bold uppercase tracking-widest px-4 py-1 rounded-full shadow-lg whitespace-nowrap">
              Most Popular
            </div>
          )}
          <div class="relative h-64 overflow-hidden rounded-t-xl">
            <img
              src={boat.image}
              alt={boat.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute top-4 right-4 bg-accent-orange text-white font-bold px-4 py-1 rounded-sm shadow-lg text-sm">
              Deposit from {formatCents(boat.startingDepositCents)}
            </div>
          </div>
          <div class="p-8 flex-grow flex flex-col">
            <h3 class="text-2xl text-white mb-2 uppercase tracking-tight">{boat.name}</h3>
            <p class="text-accent-orange text-sm font-bold uppercase tracking-widest mb-5">{boat.tagline}</p>

            <div class="flex gap-2 mb-5 flex-wrap">
              <span class="bg-nautical-light/60 text-white text-xs px-2 py-1 rounded flex items-center gap-1.5">
                <Ruler className="w-3 h-3 text-accent-orange" /> {boat.length}
              </span>
              <span class="bg-nautical-light/60 text-white text-xs px-2 py-1 rounded flex items-center gap-1.5">
                <Users className="w-3 h-3 text-accent-orange" /> Up to {boat.capacity} passengers
              </span>
            </div>

            <p class="text-slate-400 text-sm mb-6 leading-relaxed">{boat.description}</p>

            <div class="flex flex-col sm:flex-row gap-3 mt-auto">
              <a href={`/book/calendar/?class=${boat.classSlug}`} class="btn-primary sm:flex-grow py-3 text-sm text-center">Book This Class</a>
              <a
                href={`/tour-boats/${boat.slug}/`}
                class="btn-outline px-4 py-3 text-sm"
                aria-label={`Learn more about the ${boat.name} fishing boat`}
              >
                Learn More
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/tour-boats/" class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase tracking-widest hover:gap-4 transition-all text-sm">
        Compare All Boat Classes <ChevronRight className="w-5 h-5" />
      </a>
    </div>
  </div>
</section>

<style>
  .card-rise {
    transition: transform 0.3s ease;
  }
  .card-rise:hover {
    transform: translateY(-10px);
  }
</style>
