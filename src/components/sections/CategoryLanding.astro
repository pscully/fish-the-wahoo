---
import Hero from './Hero.astro';
import CTABanner from './CTABanner.astro';
import { getPackagesByCategory, type PackageData } from '../../content/packages';

export interface Props {
  category: PackageData['category'];
  headlineHtml: string;
  subheadline: string;
  bgImage?: string;
}

const { category, headlineHtml, subheadline, bgImage } = Astro.props;
const categoryPackages = getPackagesByCategory(category);
---

<Hero
  headlineHtml={headlineHtml}
  subheadline={subheadline}
  primaryCta={{ label: 'View All Packages', to: '/packages/' }}
  secondaryCta={{ label: 'Book A Trip', to: '/book/calendar/' }}
  bgImage={bgImage}
  fullscreen={false}
/>

<section class="py-20 bg-nautical-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {categoryPackages.map((pkg) => (
        <div class="metallic-card rounded-xl overflow-hidden flex flex-col group">
          <div class="relative h-52 overflow-hidden">
            <img src={pkg.image} alt={pkg.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
            <div class="absolute top-4 right-4 bg-accent-orange text-white font-bold px-3 py-1 text-sm rounded-sm">From ${pkg.priceFrom.toLocaleString()}</div>
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-lg text-white mb-2 uppercase leading-tight">{pkg.name}</h3>
            <p class="text-slate-400 text-sm leading-relaxed flex-grow mb-6">{pkg.description}</p>
            <div class="flex gap-3">
              <a href={`/book/calendar/?package=${pkg.slug}`} class="btn-primary flex-grow py-2 text-sm text-center">Book Trip</a>
              <a href={`/packages/${pkg.slug}/`} class="btn-outline px-4 py-2 text-sm">Details</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<CTABanner />
