---
export interface Props {
  headline?: string;
  subtext?: string;
  ctaLabel?: string;
  ctaTo?: string;
  bgImage?: string;
}

const {
  headline = 'Ready for an Unforgettable Adventure?',
  subtext = 'Our calendar fills up fast during peak season. Secure your date today and get ready to experience the best deep sea fishing Charleston has to offer.',
  ctaLabel = 'Check Availability',
  ctaTo = '/book/calendar/',
  bgImage = '/images/fishing-charters-hero-default.webp',
} = Astro.props;
---

<section class="py-20 bg-fixed bg-center bg-cover relative" style={`background-image: url(${bgImage})`}>
  <div class="absolute inset-0 bg-nautical-dark/80"></div>
  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-5xl text-white mb-8 uppercase">{headline}</h2>
    <p class="text-slate-300 mb-10 text-lg max-w-2xl mx-auto">{subtext}</p>
    <a href={ctaTo} class="btn-primary px-12 py-4 text-lg">{ctaLabel}</a>
  </div>
</section>
